# Which testnet the site talks to: amoy | sepolia
NEXT_PUBLIC_CHAIN=amoy
# Deployed TraceRoot address (from contracts/deployments/<network>.json)
NEXT_PUBLIC_CONTRACT_ADDRESS=
# Optional: your own free RPC (Alchemy/Infura). Falls back to the public RPC.
NEXT_PUBLIC_RPC_URL=
# Public GitHub repo link shown in the footer
NEXT_PUBLIC_GITHUB_URL=https://github.com/Sujal-tyagi17/TraceRoot
