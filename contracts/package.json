{
  "name": "traceroot-contracts",
  "version": "1.0.0",
  "description": "TraceRoot smart contracts",
  "main": "index.js",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "coverage": "hardhat coverage",
    "slither": "slither . --hardhat-ignore-compile --filter-paths node_modules",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "deploy:amoy": "hardhat run scripts/deploy.js --network amoy",
    "deploy:sepolia": "hardhat run scripts/deploy.js --network sepolia",
    "verify:amoy": "hardhat verify --network amoy",
    "seed:local": "hardhat run scripts/seed-local.js --network localhost",
    "setup:wallet": "hardhat run scripts/setup-wallet.js --network localhost"
  },
  "keywords": [],
